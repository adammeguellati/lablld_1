# =============================================================================
# LABLLD — environment variable reference
# =============================================================================
# NAMES ONLY. Never commit a real value to this file.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Source: docs/audit/CODE-AUDIT-2026-08.md §4 (branch docs/code-audit).
# All 27 variables the codebase references are listed, including the ones that
# only feed abandoned code paths — they are marked so you can skip them.
#
# Legend
#   REQUIRED  — the app will not boot, or a core screen crashes, without it
#   OPTIONAL  — a feature degrades or is unavailable, but the app runs
#   DEAD      — referenced only by code nothing imports; safe to omit entirely
#   BUILD     — NEXT_PUBLIC_*, inlined into the client bundle at compile time.
#               Must be present when `next build` runs. Setting it only at
#               runtime ships `undefined` to the browser.
#   RUNTIME   — read server-side when the request is served
#
# TODO-REAL-VALUE marks a placeholder inherited from the previous developer that
# must be replaced before launch. See the block at the end of this file for the
# four the audit found — two of them are NOT configurable here, they are
# hardcoded in source.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — database, auth, storage. Nothing works without these three.
# Obtain: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project REST URL, https://<ref>.supabase.co. BUILD. REQUIRED.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (formerly "anon") key. Safe in the browser; RLS applies. BUILD. REQUIRED.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (formerly "service_role") key. BYPASSES RLS — server-only, never expose. RUNTIME. REQUIRED.
SUPABASE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Wompi — the live payment provider (Colombia). Cards, PSE, Nequi, payment links.
# Obtain: Wompi dashboard → Desarrolladores → Llaves del comercio
# NOTE: the private key's prefix selects the environment. A prv_test_ key routes
# to sandbox.wompi.co; anything else routes to production.wompi.co (lib/wompi.ts:10).
# -----------------------------------------------------------------------------

# Public merchant key, used for card tokenisation in the browser. BUILD. REQUIRED for payments.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# Private key. Charges, payment sources, PSE/Nequi transactions, payment links. RUNTIME. REQUIRED for payments.
WOMPI_PRIVATE_KEY=

# Events secret, verifies the SHA-256 checksum on inbound webhooks. RUNTIME. REQUIRED for payments.
WOMPI_EVENTS_SECRET=

# Starter plan price in COP, integer, no separators. Read at lib/wompi.ts:74. RUNTIME. REQUIRED for subscriptions.
WOMPI_STARTER_PRICE_COP=

# Plus plan price in COP, integer. Same reader; getPlanPriceCOP() THROWS if unset. RUNTIME. REQUIRED for subscriptions.
WOMPI_PLUS_PRICE_COP=


# -----------------------------------------------------------------------------
# Stripe — GONE as of 2026-08-21 (card CODE-remove-stripe, audit R2). The five
# STRIPE_* / NEXT_PUBLIC_STRIPE_* vars that stood here are deleted along with
# lib/stripe.ts and the webhook route, so nothing in this repo reads them.
#
# TWO THINGS OUTSIDE THIS REPO STILL NEED DOING, and neither is a code change:
# delete the /api/webhooks/stripe endpoint in the Stripe dashboard (until it is
# gone Stripe keeps POSTing to a route that now 404s), and remove the five vars
# from the Vercel project so a dead secret is not sitting in the environment.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Shopify — merchant store OAuth, product publishing, order ingest, fulfillment.
# Obtain: Shopify Partners → Apps → LABLLD → Client credentials.
# The app identity is pinned in shopify.app.toml (client_id), so you inherit that
# specific app rather than creating a fresh one. See audit R9.
# -----------------------------------------------------------------------------

# App client id. Must equal shopify.app.toml:3. RUNTIME. REQUIRED for Shopify.
SHOPIFY_API_KEY=

# App client secret. Also verifies OAuth HMAC and the three GDPR compliance webhooks. RUNTIME. REQUIRED for Shopify.
SHOPIFY_API_SECRET=

# Signing secret for webhooks registered via the Dev Dashboard. For programmatically
# registered webhooks this equals SHOPIFY_API_SECRET. RUNTIME. REQUIRED for Shopify.
SHOPIFY_WEBHOOK_SECRET=

# Comma-separated OAuth scopes. Must ALSO be declared in shopify.app.toml and pushed
# with `npx shopify app config push` — since 2025 the URL scope param alone is ignored.
# RUNTIME. REQUIRED for Shopify.
SHOPIFY_SCOPES=

# Public HTTPS base for webhook callbacks. Overrides NEXT_PUBLIC_APP_URL. In local dev
# this is your ngrok tunnel; Shopify cannot deliver webhooks to localhost.
# RUNTIME. OPTIONAL (falls back to NEXT_PUBLIC_APP_URL). TODO-REAL-VALUE in dev — see block below.
SHOPIFY_WEBHOOK_BASE_URL=


# -----------------------------------------------------------------------------
# Resend — transactional email (quote sent, Shopify install link, admin notice).
# Obtain: Resend dashboard → API Keys. The sending domain must be verified.
# -----------------------------------------------------------------------------

# API key. REQUIRED, and not only for email: lib/email.ts:3 constructs the Resend
# client at MODULE SCOPE, which throws on an undefined key. Because that module is
# imported by app/admin/orders/[id]/actions.ts, an unset key takes down
# /admin/orders/[id] at import time. See audit §8.5(a) and R10. RUNTIME. REQUIRED.
RESEND_API_KEY=

# From header, e.g. "LABLLD <noreply@yourdomain>". Falls back to a hardcoded
# lablld.com address if unset. RUNTIME. OPTIONAL.
RESEND_FROM_EMAIL=


# -----------------------------------------------------------------------------
# Mockup rendering
# -----------------------------------------------------------------------------

# SudoMock API key — the LIVE mockup provider (lib/sudomock.ts). Credit-metered;
# the app caps renders at 6 per merchant per month. Obtain: SudoMock dashboard.
# RUNTIME. REQUIRED for mockup generation.
SUDOMOCK_API_KEY=

# Dynamic Mockups — superseded by SudoMock. Its only caller chain is unreachable.
# RUNTIME. DEAD — omit. See audit §8.3.
DYNAMIC_MOCKUPS_API_KEY=


# -----------------------------------------------------------------------------
# Envia.com — shipping rates and labels. Fully written, imported by NOTHING.
# See audit §8.3 and card CODE-remove-dead-integrations. Omit both.
# -----------------------------------------------------------------------------

# API key. RUNTIME. DEAD — omit.
ENVIA_API_KEY=

# API base URL. Defaults to the TEST endpoint (api.ship-test.envia.com) when unset,
# so this would silently stay in test even in production. RUNTIME. DEAD — omit.
ENVIA_API_URL=


# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------

# Public base URL of this deployment, no trailing slash. Used for Supabase auth
# email redirects, Shopify OAuth callbacks and Wompi return URLs. Falls back to a
# hardcoded production URL in exactly one place (app/(auth)/actions.ts:57), which
# will silently send local signup confirmation emails to production if unset.
# Local dev: http://localhost:3000. BUILD. REQUIRED. TODO-REAL-VALUE per environment.
NEXT_PUBLIC_APP_URL=

# Comma-separated admin email allowlist. This is the ENTIRE admin mechanism —
# admins have no row in `merchants` and no database role. Read at module scope
# (lib/utils.ts:37), so changes need a redeploy, not just an env update.
# RUNTIME. REQUIRED (without it no user can reach /admin).
ADMIN_EMAILS=

# Bearer token for the daily billing cron. Vercel Cron sends it automatically when
# set as a project env var; app/api/cron/billing/route.ts:10 returns 401 otherwise.
# IF UNSET, ALL SUBSCRIPTION BILLING SILENTLY STOPS. Generate a long random string.
# RUNTIME. REQUIRED in any environment that charges.
CRON_SECRET=


